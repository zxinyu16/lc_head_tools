<view class="page" wx:if="{{business}}"><view class="eyebrow">DOCUMENT HEADER</view><view class="title">制作单据抬头</view><view class="subtitle">{{saved || '业务信息保存在本机'}} · {{business.name}}</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="tabs"><button class="{{step === 0 ? 'selected' : ''}}" data-step="0" bindtap="stepTo">1 手填</button><button class="{{step === 1 ? 'selected' : ''}}" data-step="1" bindtap="stepTo">2 信用证</button><button class="{{step === 2 ? 'selected' : ''}}" data-step="2" bindtap="stepTo">3 核对</button></view>
<block wx:if="{{step === 0}}"><view class="step-help">先填写你知道或愿意填写的内容，其余信息可在导入信用证后补充。此步无需确认。</view><view class="card"><view class="section">业务名称</view><input value="{{business.name}}" bindinput="nameInput" maxlength="80"/></view><view class="card" wx:for="{{fields}}" wx:key="key"><view class="label" style="margin-top:0">{{item.label}}{{item.key === 'lcNumber' ? '（可留空）' : ''}}</view><textarea wx:if="{{item.multi}}" value="{{item.value}}" data-key="{{item.key}}" bindinput="fieldInput" maxlength="2000"/><picker wx:elif="{{item.date}}" mode="date" value="{{item.value}}" data-key="{{item.key}}" bindchange="fieldInput"><view class="select">{{item.value || '选择日期'}}<text>›</text></view></picker><input wx:else value="{{item.value}}" data-key="{{item.key}}" bindinput="fieldInput" maxlength="200"/></view><view class="card"><view class="section">已知的其他编号或要求</view><view class="muted">每行一条，例如：PI编号：PI-2026-001。导入后需确认适用单据。</view><textarea style="margin-top:20rpx" placeholder="PI编号：PI-2026-001" value="{{keywordText}}" bindinput="keywords" maxlength="5000"/><button style="margin-top:20rpx" bindtap="parseKeywords">整理为待确认字段</button><view wx:for="{{pendingKeywords}}" wx:key="index" class="source" style="margin-top:14rpx">{{item.name}}：{{item.value || '待补充'}}</view><button wx:if="{{pendingKeywords.length}}" class="primary" style="margin-top:20rpx" bindtap="acceptKeywords">加入额外条款</button></view><button class="primary" data-step="1" bindtap="stepTo">下一步：导入信用证文本</button></block>
<block wx:if="{{step === 1}}"><view class="step-help">导入信用证文本后自动提取有用信息为候选；你仍需在下一步决定保留内容和适用单据。没有文本可直接跳过。</view><view class="card"><view class="section">原件附件（可选）</view><view class="notice" style="margin-top:24rpx">PDF / 图片只能保存为原件附件，当前不能自动抓取。可复制的 SWIFT 文本或 .txt 文件才能提取候选。</view><view class="actions"><button class="primary" bindtap="chooseFile">导入 PDF / 文件</button><button bindtap="chooseImage">相册 / 拍照</button></view><view wx:for="{{business.sourceFiles}}" wx:key="id" class="history row"><view class="grow small">{{item.name}}</view><button class="link" data-id="{{item.id}}" bindtap="viewFile">查看原件</button></view></view><view class="card"><view class="section">导入信用证文本</view><view class="muted">支持 :20:、:50:、:59:、:46A:、:47A: 等场次。可粘贴文字，或从微信会话选择 .txt 文件。提取结果须人工核对。</view><button style="margin-top:20rpx" bindtap="importLcText">选择 .txt 文件</button><view wx:if="{{lcTextName}}" class="source-status">已读入并提取 {{lcTextName}} 的候选，请检查下方结果。</view><textarea style="margin-top:20rpx" placeholder="粘贴包含 :20:、:46A: 等场次的信用证文字" value="{{lcInput}}" bindinput="lcInput" maxlength="30000"/><button style="margin-top:20rpx" bindtap="parseLc">提取候选内容</button><view wx:if="{{lcCandidates}}"><view class="label">基础字段候选</view><view wx:for="{{lcCandidates.fields}}" wx:key="index" class="source"><view class="small">{{item.label}} · {{item.source}} 场</view><textarea value="{{item.value}}" data-index="{{index}}" bindinput="editLcField" maxlength="2000"/><view class="check"><switch checked="{{item.selected}}" data-index="{{index}}" bindchange="selectLcField"/><text>确认导入（导入后仍需核对）</text></view></view><view class="label">46 / 47 场条款候选</view><view wx:for="{{lcCandidates.clauses}}" wx:key="index" class="source"><view class="small">{{item.source}} 场 · {{item.type === 'operation' ? '操作要求' : '编号字段'}} · 原文：{{item.raw}}</view><input value="{{item.name}}" data-index="{{index}}" data-key="name" bindinput="editLcClause"/><input value="{{item.value}}" data-index="{{index}}" data-key="value" bindinput="editLcClause"/><picker range="{{scopes}}" data-index="{{index}}" bindchange="scopeLcClause"><view class="select">{{item.scope.length === 0 ? '选择适用单据' : (item.scope.length === 2 ? '全部单据' : (item.scope[0] === 'invoice' ? '发票' : '装箱单'))}}<text>›</text></view></picker><view class="check"><switch checked="{{item.selected}}" data-index="{{index}}" bindchange="selectLcClause"/><text>确认导入（导入后仍需核对）</text></view></view><view wx:if="{{lcCandidates.unresolved.length}}" class="label">未自动整理的 46 / 47 场原文</view><view wx:for="{{lcCandidates.unresolved}}" wx:key="index" class="source small">{{item.source}}：{{item.raw}}</view><button class="primary" style="margin-top:20rpx" bindtap="acceptLc">导入已选候选</button></view></view><button class="primary" data-step="2" bindtap="stepTo">下一步：核对并选择输出内容</button></block>
<block wx:if="{{step === 2}}"><view class="step-help">逐项确认保留内容及其适用单据。发票必须含卖方、买方、发票号和日期；装箱单必须含卖方、买方。</view><view class="section">基础表头信息</view><view class="card" wx:for="{{fields}}" wx:key="key"><view class="label" style="margin-top:0">{{item.label}}{{item.key === 'lcNumber' ? '（可留空）' : ''}}</view><textarea wx:if="{{item.multi}}" value="{{item.value}}" data-key="{{item.key}}" bindinput="fieldInput" maxlength="2000"/><picker wx:elif="{{item.date}}" mode="date" value="{{item.value}}" data-key="{{item.key}}" bindchange="fieldInput"><view class="select">{{item.value || '选择日期'}}<text>›</text></view></picker><input wx:else value="{{item.value}}" data-key="{{item.key}}" bindinput="fieldInput" maxlength="200"/><view class="label">保留在哪些单据</view><picker range="{{fieldScopeOptions}}" value="{{item.scopeIndex}}" data-key="{{item.key}}" bindchange="fieldScope"><view class="select">{{fieldScopeOptions[item.scopeIndex]}}<text>›</text></view></picker><view class="check"><switch color="#176b52" checked="{{item.confirmed}}" data-key="{{item.key}}" bindchange="confirmField"/><text>内容和单据范围已核对</text></view></view><view class="section">额外编号与要求</view><view class="card"><view class="section">快速填写关键词</view><view class="muted">每行一条，例如：PI编号：PI-2026-001。导入后需确认适用单据。</view><textarea style="margin-top:20rpx" placeholder="PI编号：PI-2026-001" value="{{keywordText}}" bindinput="keywords" maxlength="5000"/><button style="margin-top:20rpx" bindtap="parseKeywords">整理为待确认字段</button><view wx:for="{{pendingKeywords}}" wx:key="index" class="source" style="margin-top:14rpx">{{item.name}}：{{item.value || '待补充'}}</view><button wx:if="{{pendingKeywords.length}}" class="primary" style="margin-top:20rpx" bindtap="acceptKeywords">加入额外条款</button></view><view class="notice">重点核对信用证 46 / 47 场要求。编号和固定文字进入单据，签字等操作要求进入检查清单。</view><view wx:if="{{!clauses.length}}" class="card empty">暂无额外条款，可添加 PI、保单编号等。</view><view wx:for="{{clauses}}" wx:key="id" class="card"><view class="row"><text class="tag {{item.missing ? 'warn' : ''}}">{{item.missing ? '待补充' : (item.confirmed ? '已核对' : '待核对')}}</text><button class="link" data-id="{{item.id}}" bindtap="removeClause">删除</button></view><view class="label">名称 / 关键词</view><input value="{{item.name}}" placeholder="如：保单编号" data-id="{{item.id}}" data-key="name" bindinput="clauseInput" maxlength="100"/><view class="label">内容 / 编号值</view><textarea value="{{item.value}}" placeholder="未提供的编号请留空，稍后补充" data-id="{{item.id}}" data-key="value" bindinput="clauseInput" maxlength="4000"/><view class="label">条款类型</view><picker range="{{types}}" value="{{item.typeIndex}}" data-id="{{item.id}}" bindchange="clauseType"><view class="select">{{types[item.typeIndex]}}<text>›</text></view></picker><view class="label">适用单据</view><picker range="{{scopes}}" value="{{item.scopeIndex}}" data-id="{{item.id}}" bindchange="clauseScope"><view class="select">{{item.scope.length ? scopes[item.scopeIndex] : '请选择适用单据'}}<text>›</text></view></picker><view class="check"><switch color="#176b52" checked="{{item.required}}" data-id="{{item.id}}" bindchange="required"/><text>必填项</text></view><view class="check"><switch color="#176b52" checked="{{item.confirmed}}" data-id="{{item.id}}" bindchange="confirmClause"/><text>已核对内容与适用范围</text></view></view><button bindtap="addClause">＋ 新增额外条款</button><view class="actions"><button bindtap="saveAsTemplate">保存字段模板</button><button class="primary" bindtap="preview">查看检查与一键生成</button></view></block></view>
