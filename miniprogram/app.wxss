page{background:#f4f3ee;color:#24332f;font-family:'PingFang SC','Noto Sans SC',sans-serif;font-size:28rpx;line-height:1.6}.page{padding:36rpx 30rpx 160rpx}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#176b52;margin-bottom:10rpx}.title{font-size:46rpx;font-weight:600;line-height:1.35;margin-bottom:16rpx}.subtitle{font-size:25rpx;color:#737c75;margin-bottom:28rpx}.notice{background:#ecebdf;border-radius:10rpx;padding:16rpx 20rpx;font-size:22rpx;color:#77603c;margin-bottom:28rpx}.card{background:#fff;border:1rpx solid #dedfd7;border-radius:16rpx;padding:28rpx;margin-bottom:22rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.grow{flex:1;min-width:0}.section{font-size:31rpx;font-weight:600;margin-bottom:20rpx}.muted{color:#737c75;font-size:23rpx}.small{font-size:22rpx}.tag{font-size:21rpx;padding:4rpx 14rpx;background:#edf3ee;color:#176b52;border-radius:6rpx;white-space:nowrap}.warn{background:#fcf2dc;color:#996118}.divider{border-top:1rpx solid #e4e6df;margin:24rpx 0}.label{font-size:24rpx;margin:22rpx 0 9rpx;color:#4e6056}input,textarea,.select{border:1rpx solid #d8ddd4;background:#fbfcf9;padding:18rpx 20rpx;border-radius:10rpx;box-sizing:border-box;width:100%;font-size:28rpx;min-height:78rpx}textarea{height:150rpx;line-height:1.5}.select{display:flex;align-items:center;justify-content:space-between}.actions{display:flex;gap:16rpx;flex-wrap:wrap;margin-top:24rpx}.actions button{flex:1;min-width:180rpx}button{font-size:27rpx;font-weight:500;border-radius:10rpx;margin:0;padding:0 24rpx;line-height:84rpx;background:#edf1e9;color:#24332f}button::after{border:0}button.primary{background:#176b52;color:#fff}button.secondary{background:#fff;border:1rpx solid #d8ddd4}button.link{background:none;color:#176b52;line-height:60rpx;font-size:24rpx;padding:0 10rpx;flex:none;min-width:0}button.danger{color:#ae4638;background:#fbefec}button[disabled]{background:#dce2d9;color:#859086}.empty{text-align:center;padding:60rpx 20rpx;color:#737c75}.check{display:flex;align-items:center;font-size:25rpx;margin-top:20rpx}.check switch{transform:scale(.8);transform-origin:left center}.footer{padding:22rpx 0}.meta{font-size:22rpx;color:#737c75;margin-top:12rpx}.name{font-size:31rpx;font-weight:550;word-break:break-all}.linebreak{white-space:pre-wrap;word-break:break-all}.tabs{display:flex;gap:12rpx;margin:20rpx 0 28rpx}.tabs button{font-size:24rpx;flex:1;line-height:72rpx;padding:0 8rpx}.tabs .selected{background:#176b52;color:white}.count{font:52rpx Georgia,serif}.fieldnote{font-size:22rpx;color:#996118;margin-top:8rpx}.paper{background:white;padding:36rpx 28rpx;margin:22rpx 0;border:1rpx solid #dedfd7;border-radius:4rpx;font-family:Georgia,'PingFang SC',serif}.paper-title{font-size:38rpx;border-bottom:3rpx solid #24332f;padding-bottom:22rpx;line-height:1.3}.paper-label{font-size:21rpx;color:#737c75;margin-top:26rpx;letter-spacing:2rpx}.paper-value{font-size:27rpx;white-space:pre-wrap;word-break:break-all}.source{background:#f4f5ee;padding:22rpx;border-left:4rpx solid #a66a16;font-size:25rpx;white-space:pre-wrap}.error{padding:20rpx;background:#fbece8;color:#a24030;margin-bottom:20rpx;word-break:break-all}.history{padding:20rpx 0;border-bottom:1rpx solid #dedfd7}
.flow-line{font-size:23rpx;color:#4e6056;background:#e8efe8;padding:18rpx 20rpx;border-radius:10rpx;margin:0 0 30rpx}.flow-line text{color:#176b52;margin:0 8rpx}.entry-card{display:flex;align-items:center;gap:22rpx;background:#fff;border:1rpx solid #d8ddd4;border-left:7rpx solid #176b52;border-radius:12rpx;padding:26rpx 20rpx;margin:16rpx 0}.entry-number{font:30rpx Georgia,serif;color:#176b52}.entry-title{font-size:30rpx;font-weight:600;margin-bottom:4rpx}.entry-arrow{font-size:45rpx;color:#176b52}.step-help{font-size:24rpx;color:#4e6056;margin:0 0 24rpx}.source-status{background:#edf3ee;border-left:4rpx solid #176b52;padding:16rpx 20rpx;font-size:23rpx;margin-top:20rpx}
